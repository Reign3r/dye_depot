{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Yapetto",
    "Ninni"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/dye_depot",
    "issues": "https://github.com/${repository}/issues",
    "sources": "https://github.com/${repository}"
  },
  "license": "CC0-1.0",
  "accessWidener": "${mod_id}.accesswidener",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.ninni.dye_depot.DyeDepot"
    ],
    "fabric-datagen": [
      "com.ninni.dye_depot.data.DyeDepotDatagen"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "polymer-core": ">=0.17.3",
    "polymer-blocks": ">=0.17.3",
    "polymer-resource-pack": ">=0.17.3",
    "polymer-resource-pack-extras": ">=0.17.3",
    "polymer-virtual-entity": ">=0.17.3",
    "minecraft": "~26.2",
    "java": ">=25"
  }
